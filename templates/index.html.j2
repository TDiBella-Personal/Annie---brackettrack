<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Annie's Madness Tracker</title>
    <style>
        :root {
            --bg-primary: #0d0d12;
            --bg-surface: #1a1a22;
            --accent: #d4a563;
            --accent-muted: #8a6e3e;
            --light: #e0e0e0;
            --text-dark: #0d0d12;
            --white: #ffffff;
            --eliminated: rgba(255, 255, 255, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: var(--bg-primary);
            color: var(--accent);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, sans-serif;
            min-height: 100vh;
        }

        /* Header */
        .header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 24px 20px 16px;
            border-bottom: 2px solid var(--accent-muted);
        }

        .grogu-container {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .grogu-container svg {
            filter: drop-shadow(0 0 12px rgba(212, 165, 99, 0.4));
        }

        .header h1 {
            font-size: 2rem;
            letter-spacing: -0.5px;
        }

        .updated-time {
            font-size: 0.8rem;
            color: var(--accent-muted);
            text-align: center;
            padding: 6px 0;
        }

        {% if stale %}.stale-warning {
            background: #4a2a1a;
            color: #ffb366;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            font-size: 0.9rem;
        }{% endif %}

        /* Toggle */
        .toggle-container {
            display: flex;
            justify-content: center;
            padding: 16px;
        }

        .toggle-btn {
            padding: 10px 32px;
            font-size: 1rem;
            font-weight: 700;
            border: 2px solid var(--accent);
            background: transparent;
            color: var(--accent);
            cursor: pointer;
            transition: all 0.2s;
        }

        .toggle-btn:first-child { border-radius: 8px 0 0 8px; }
        .toggle-btn:last-child { border-radius: 0 8px 8px 0; }

        .toggle-btn.active {
            background: var(--accent);
            color: var(--text-dark);
        }

        .toggle-btn:hover:not(.active) {
            background: rgba(212, 165, 99, 0.15);
        }

        /* Sections */
        .tournament-section { display: none; }
        .tournament-section.active { display: block; }

        .section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .section h2 {
            font-size: 1.4rem;
            margin-bottom: 16px;
            color: var(--accent);
            border-bottom: 1px solid var(--accent-muted);
            padding-bottom: 8px;
        }

        /* Bracket image */
        .bracket-container {
            text-align: center;
            margin-bottom: 24px;
        }

        .bracket-img {
            max-width: 100%;
            height: auto;
            border: 2px solid var(--accent-muted);
            border-radius: 8px;
        }

        /* Zoom bracket */
        .zoom-controls {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .zoom-btn {
            padding: 8px 20px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 2px solid var(--accent);
            background: transparent;
            color: var(--accent);
            cursor: pointer;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .zoom-btn.active {
            background: var(--accent);
            color: var(--text-dark);
        }

        .zoom-btn:hover:not(.active) {
            background: rgba(212, 165, 99, 0.15);
        }

        .download-btn {
            display: inline-block;
            margin-top: 12px;
            padding: 10px 24px;
            background: var(--light);
            color: var(--text-dark);
            text-decoration: none;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.95rem;
            transition: background 0.2s;
        }

        .download-btn:hover { background: var(--accent); }

        /* Score cards */
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .score-card {
            background: var(--bg-surface);
            border: 1px solid var(--accent-muted);
            border-radius: 8px;
            padding: 16px;
        }

        .score-card .round-label {
            font-size: 0.75rem;
            color: var(--accent-muted);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .score-card .team-row {
            display: flex;
            align-items: center;
            padding: 6px 0;
            gap: 8px;
        }

        .score-card .seed {
            font-size: 0.8rem;
            color: var(--accent-muted);
            min-width: 28px;
            text-align: center;
        }

        .score-card .team-name {
            flex: 1;
            font-weight: 600;
        }

        .score-card .team-name.winner { color: var(--accent); }
        .score-card .team-name.loser {
            color: var(--eliminated);
            text-decoration: line-through;
        }

        .score-card .score {
            font-weight: 700;
            font-size: 1.1rem;
            min-width: 36px;
            text-align: right;
        }

        .score-card .score.winner { color: var(--white); }
        .score-card .score.loser { color: var(--eliminated); }

        .score-card .game-info {
            font-size: 0.75rem;
            color: var(--accent-muted);
            margin-top: 6px;
            text-align: right;
        }

        /* No games message */
        .no-games {
            text-align: center;
            padding: 40px;
            color: var(--accent-muted);
            font-size: 1.1rem;
        }

        /* News */
        .news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .news-card {
            background: var(--bg-surface);
            border-left: 4px solid var(--accent);
            border-radius: 0 8px 8px 0;
            padding: 16px;
        }

        .news-card h3 {
            font-size: 0.95rem;
            color: var(--light);
            margin-bottom: 8px;
        }

        .news-card p {
            font-size: 0.82rem;
            color: var(--accent-muted);
            line-height: 1.5;
            margin-bottom: 8px;
        }

        .news-card a {
            font-size: 0.78rem;
            color: var(--accent);
            text-decoration: none;
        }

        .news-card a:hover { text-decoration: underline; }

        /* Footer */
        .footer {
            text-align: center;
            padding: 24px;
            border-top: 2px solid var(--accent-muted);
            margin-top: 24px;
        }

        .footer .tagline {
            font-size: 1.1rem;
            font-style: italic;
            color: var(--accent);
            margin-bottom: 4px;
        }

        .footer .timestamp {
            font-size: 0.75rem;
            color: var(--accent-muted);
        }

        /* Highlight photos */
        .highlight-photos {
            display: flex;
            justify-content: center;
            gap: 16px;
            padding: 16px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .highlight-photo {
            flex: 1;
            max-width: 580px;
        }

        .highlight-photo img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid var(--accent-muted);
        }

        .photo-caption {
            font-size: 0.82rem;
            color: var(--light);
            margin-top: 6px;
        }

        .photo-credit {
            font-size: 0.7rem;
            color: var(--accent-muted);
        }

        /* Team logos */
        .team-logo {
            width: 20px;
            height: 20px;
            object-fit: contain;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .header h1 { font-size: 1.4rem; }
            .results-grid, .news-grid { grid-template-columns: 1fr; }
            .highlight-photos { flex-direction: column; align-items: center; }
        }
    </style>
</head>
<body>

<!-- Header -->
<header class="header">
    <div class="grogu-container">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="90" height="90">
            <!-- Left ear -->
            <ellipse cx="10" cy="60" rx="22" ry="9" fill="#3a8a5a" transform="rotate(-30 10 60)"/>
            <ellipse cx="12" cy="60" rx="18" ry="6" fill="#4fc882" transform="rotate(-30 12 60)"/>
            <ellipse cx="14" cy="59" rx="12" ry="3.5" fill="#6be0a0" transform="rotate(-30 14 59)"/>
            <!-- Right ear -->
            <ellipse cx="110" cy="60" rx="22" ry="9" fill="#3a8a5a" transform="rotate(30 110 60)"/>
            <ellipse cx="108" cy="60" rx="18" ry="6" fill="#4fc882" transform="rotate(30 108 60)"/>
            <ellipse cx="106" cy="59" rx="12" ry="3.5" fill="#6be0a0" transform="rotate(30 106 59)"/>
            <!-- Robe body (behind head) -->
            <path d="M 28 72 C 22 85 20 105 28 118 L 92 118 C 100 105 98 85 92 72 Q 60 90 28 72Z" fill="#7A6345"/>
            <path d="M 32 74 Q 60 88 88 74 C 92 88 92 108 88 118 L 32 118 C 28 108 28 88 32 74Z" fill="#8B7355"/>
            <!-- Robe front panel -->
            <path d="M 42 78 Q 60 86 78 78 L 72 118 L 48 118 Z" fill="#A0896C"/>
            <!-- Collar -->
            <path d="M 32 74 Q 36 66 44 72" stroke="#6B5535" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M 88 74 Q 84 66 76 72" stroke="#6B5535" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <!-- Fold lines -->
            <path d="M 58 86 L 56 118" stroke="#6B5535" stroke-width="1" fill="none" opacity="0.5"/>
            <path d="M 62 86 L 64 118" stroke="#6B5535" stroke-width="0.8" fill="none" opacity="0.4"/>
            <!-- Head -->
            <ellipse cx="60" cy="55" rx="30" ry="35" fill="#3a8a5a"/>
            <ellipse cx="60" cy="55" rx="28" ry="33" fill="#4fc882"/>
            <ellipse cx="60" cy="56" rx="25" ry="29" fill="#5ad492"/>
            <!-- Wrinkles -->
            <path d="M 45 35 Q 60 32 75 35" stroke="#3a8a5a" stroke-width="0.8" fill="none" opacity="0.5"/>
            <path d="M 47 38 Q 60 36 73 38" stroke="#3a8a5a" stroke-width="0.6" fill="none" opacity="0.4"/>
            <!-- Left eye -->
            <ellipse cx="48" cy="52" rx="8" ry="9.5" fill="#111"/>
            <ellipse cx="50" cy="50" rx="3" ry="3.5" fill="#4fc882"/>
            <circle cx="51" cy="48" r="1.2" fill="white" opacity="0.8"/>
            <!-- Right eye -->
            <ellipse cx="72" cy="52" rx="8" ry="9.5" fill="#111"/>
            <ellipse cx="74" cy="50" rx="3" ry="3.5" fill="#4fc882"/>
            <circle cx="75" cy="48" r="1.2" fill="white" opacity="0.8"/>
            <!-- Nose -->
            <ellipse cx="60" cy="60" rx="1.5" ry="1" fill="#3a8a5a"/>
            <!-- Mouth -->
            <path d="M 52 66 Q 60 72 68 66" stroke="#3a8a5a" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <!-- Hands -->
            <ellipse cx="30" cy="98" rx="6" ry="4" fill="#5ad492" transform="rotate(-10 30 98)"/>
            <ellipse cx="90" cy="98" rx="6" ry="4" fill="#5ad492" transform="rotate(10 90 98)"/>
            <!-- Basketball -->
            <circle cx="95" cy="100" r="9" fill="#e87830" stroke="#c06020" stroke-width="1"/>
            <path d="M 86 100 Q 95 96 104 100" stroke="#c06020" stroke-width="0.8" fill="none"/>
            <path d="M 86 100 Q 95 104 104 100" stroke="#c06020" stroke-width="0.8" fill="none"/>
            <line x1="95" y1="91" x2="95" y2="109" stroke="#c06020" stroke-width="0.8"/>
        </svg>
    </div>
    <h1>Annie's Madness Tracker</h1>
</header>

<p class="updated-time">Last updated: {{ updated_time }}</p>

{% if stale %}
<div class="stale-warning">Data may be outdated - using cached results from {{ data_source }}</div>
{% endif %}

{% if highlight_photos %}
<!-- Highlight Photos -->
<div class="highlight-photos">
    {% for photo in highlight_photos %}
    <div class="highlight-photo">
        <img src="{{ photo.local_path }}" alt="{{ photo.caption }}">
        <p class="photo-caption">{{ photo.caption }}</p>
        {% if photo.credit %}<p class="photo-credit">{{ photo.credit }}</p>{% endif %}
    </div>
    {% endfor %}
</div>
{% endif %}

<!-- Tournament Toggle -->
<div class="toggle-container">
    <button class="toggle-btn active" onclick="switchTournament('mens')" id="btn-mens">Men's</button>
    <button class="toggle-btn" onclick="switchTournament('womens')" id="btn-womens">Women's</button>
</div>

<!-- Men's Tournament -->
<div class="tournament-section active" id="section-mens">

    <!-- Full Bracket -->
    <div class="section">
        <h2>Bracket</h2>
        <div class="zoom-controls">
            <button class="zoom-btn active" onclick="toggleZoom('mens', 'full')" id="mens-zoom-full">Full Bracket</button>
            <button class="zoom-btn" onclick="toggleZoom('mens', 'zoom')" id="mens-zoom-zoom">Zoom (Active Rounds)</button>
        </div>
        <div class="bracket-container" id="mens-bracket-full">
            <img src="images/mens-full-bracket.png" alt="Men's Tournament Bracket" class="bracket-img">
            <br>
            <a href="images/mens-full-bracket.png" download="mens-bracket.png" class="download-btn">Download for Projection</a>
        </div>
        <div class="bracket-container" id="mens-bracket-zoom" style="display:none;">
            <img src="images/mens-zoom-bracket.png" alt="Men's Active Rounds" class="bracket-img">
            <br>
            <a href="images/mens-zoom-bracket.png" download="mens-zoom-bracket.png" class="download-btn">Download for Projection</a>
        </div>
    </div>

    <!-- Today's Matchups -->
    <div class="section">
        <h2>Today's Matchups</h2>
        <div class="bracket-container">
            <img src="images/mens-today-view.png" alt="Men's Today's Games" class="bracket-img">
            <br>
            <a href="images/mens-today-view.png" download="mens-today.png" class="download-btn">Download for Projection</a>
        </div>
        {% if not mens_todays_games %}
        <p class="no-games">No men's games scheduled today.</p>
        {% endif %}
    </div>

    <!-- Last Night's Results -->
    <div class="section">
        <h2>Last Night's Results</h2>
        {% if mens_last_results %}
        <div class="results-grid">
            {% for game in mens_last_results %}
            <div class="score-card">
                <div class="round-label">{{ game.round }}{% if game.region %} - {{ game.region }}{% endif %}</div>
                <div class="team-row">
                    <span class="seed">({{ game.home.seed }})</span>
                    <img class="team-logo" src="https://ncaa-api.henrygd.me/logo/{{ game.home.name | team_slug }}.svg" alt="" width="20" height="20" onerror="this.style.display='none'">
                    <span class="team-name {{ 'winner' if game.home.winner else 'loser' }}">{{ game.home.name }}</span>
                    <span class="score {{ 'winner' if game.home.winner else 'loser' }}">{{ game.home.score }}</span>
                </div>
                <div class="team-row">
                    <span class="seed">({{ game.away.seed }})</span>
                    <img class="team-logo" src="https://ncaa-api.henrygd.me/logo/{{ game.away.name | team_slug }}.svg" alt="" width="20" height="20" onerror="this.style.display='none'">
                    <span class="team-name {{ 'winner' if game.away.winner else 'loser' }}">{{ game.away.name }}</span>
                    <span class="score {{ 'winner' if game.away.winner else 'loser' }}">{{ game.away.score }}</span>
                </div>
                <div class="game-info">{{ game.network }}</div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="no-games">No recent results to show.</p>
        {% endif %}
    </div>

    <!-- Tournament Stories -->
    <div class="section">
        <h2>Tournament Stories</h2>
        <div class="news-grid">
            {% for story in mens_news %}
            <div class="news-card">
                <h3>{{ story.title }}</h3>
                <p>{{ story.summary }}</p>
                <a href="{{ story.source_url }}" target="_blank" rel="noopener">{{ story.source_name }}</a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Women's Tournament -->
<div class="tournament-section" id="section-womens">

    <!-- Full Bracket -->
    <div class="section">
        <h2>Bracket</h2>
        <div class="zoom-controls">
            <button class="zoom-btn active" onclick="toggleZoom('womens', 'full')" id="womens-zoom-full">Full Bracket</button>
            <button class="zoom-btn" onclick="toggleZoom('womens', 'zoom')" id="womens-zoom-zoom">Zoom (Active Rounds)</button>
        </div>
        <div class="bracket-container" id="womens-bracket-full">
            <img src="images/womens-full-bracket.png" alt="Women's Tournament Bracket" class="bracket-img">
            <br>
            <a href="images/womens-full-bracket.png" download="womens-bracket.png" class="download-btn">Download for Projection</a>
        </div>
        <div class="bracket-container" id="womens-bracket-zoom" style="display:none;">
            <img src="images/womens-zoom-bracket.png" alt="Women's Active Rounds" class="bracket-img">
            <br>
            <a href="images/womens-zoom-bracket.png" download="womens-zoom-bracket.png" class="download-btn">Download for Projection</a>
        </div>
    </div>

    <!-- Today's Matchups -->
    <div class="section">
        <h2>Today's Matchups</h2>
        <div class="bracket-container">
            <img src="images/womens-today-view.png" alt="Women's Today's Games" class="bracket-img">
            <br>
            <a href="images/womens-today-view.png" download="womens-today.png" class="download-btn">Download for Projection</a>
        </div>
        {% if not womens_todays_games %}
        <p class="no-games">No women's games scheduled today.</p>
        {% endif %}
    </div>

    <!-- Last Night's Results -->
    <div class="section">
        <h2>Last Night's Results</h2>
        {% if womens_last_results %}
        <div class="results-grid">
            {% for game in womens_last_results %}
            <div class="score-card">
                <div class="round-label">{{ game.round }}{% if game.region %} - {{ game.region }}{% endif %}</div>
                <div class="team-row">
                    <span class="seed">({{ game.home.seed }})</span>
                    <img class="team-logo" src="https://ncaa-api.henrygd.me/logo/{{ game.home.name | team_slug }}.svg" alt="" width="20" height="20" onerror="this.style.display='none'">
                    <span class="team-name {{ 'winner' if game.home.winner else 'loser' }}">{{ game.home.name }}</span>
                    <span class="score {{ 'winner' if game.home.winner else 'loser' }}">{{ game.home.score }}</span>
                </div>
                <div class="team-row">
                    <span class="seed">({{ game.away.seed }})</span>
                    <img class="team-logo" src="https://ncaa-api.henrygd.me/logo/{{ game.away.name | team_slug }}.svg" alt="" width="20" height="20" onerror="this.style.display='none'">
                    <span class="team-name {{ 'winner' if game.away.winner else 'loser' }}">{{ game.away.name }}</span>
                    <span class="score {{ 'winner' if game.away.winner else 'loser' }}">{{ game.away.score }}</span>
                </div>
                <div class="game-info">{{ game.network }}</div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="no-games">No recent results to show.</p>
        {% endif %}
    </div>

    <!-- Tournament Stories -->
    <div class="section">
        <h2>Tournament Stories</h2>
        <div class="news-grid">
            {% for story in womens_news %}
            <div class="news-card">
                <h3>{{ story.title }}</h3>
                <p>{{ story.summary }}</p>
                <a href="{{ story.source_url }}" target="_blank" rel="noopener">{{ story.source_name }}</a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="footer">
    <p class="tagline">This is the way.</p>
    <p class="timestamp">Updated: {{ updated_time }}</p>
</footer>

<script>
function switchTournament(which) {
    document.getElementById('section-mens').classList.toggle('active', which === 'mens');
    document.getElementById('section-womens').classList.toggle('active', which === 'womens');
    document.getElementById('btn-mens').classList.toggle('active', which === 'mens');
    document.getElementById('btn-womens').classList.toggle('active', which === 'womens');
}

function toggleZoom(gender, mode) {
    var fullEl = document.getElementById(gender + '-bracket-full');
    var zoomEl = document.getElementById(gender + '-bracket-zoom');
    var fullBtn = document.getElementById(gender + '-zoom-full');
    var zoomBtn = document.getElementById(gender + '-zoom-zoom');

    if (mode === 'full') {
        fullEl.style.display = '';
        zoomEl.style.display = 'none';
        fullBtn.classList.add('active');
        zoomBtn.classList.remove('active');
    } else {
        fullEl.style.display = 'none';
        zoomEl.style.display = '';
        fullBtn.classList.remove('active');
        zoomBtn.classList.add('active');
    }
}
</script>

</body>
</html>
